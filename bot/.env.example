# Project Kei — 配置模板
# 复制为 .env 后填写：Copy-Item .env.example .env
# 变量名 = bot/config.py 里的字段名大写。留空的项会使用代码默认值。

# ─── NoneBot ──────────────────────────────────────────
DRIVER=~fastapi+~websockets
PORT=8081

# SnowLuma 的 OneBot v11 WebSocket 地址（SnowLuma 是服务端）
ONEBOT_V11_WS_URLS=["ws://127.0.0.1:8080/"]

# 相对 data/ 的数据库文件名
DB_PATH=db.sqlite3

# ─── 监控 ─────────────────────────────────────────────
# B站/斗鱼轮询间隔（秒）
POLL_INTERVAL=30

# B站 Cookie（可选，能提高 API 稳定性）
# 格式：buvid3=xxx; SESSDATA=xxx; bili_jct=xxx
BILIBILI_COOKIE=

# Pixiv 基础轮询间隔（秒）。订阅数多时会自动放大
# PIXIV_POLL_INTERVAL=300
# PIXIV_MAX_IMAGES=9
# PIXIV_MAX_IMAGE_SIDE=1200

# ─── LLM ──────────────────────────────────────────────
# deepseek / gemini
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 仅 Gemini 需要走代理时填写，如 http://127.0.0.1:7890
LLM_PROXY=

# 对话温度。⚠️ 开启 LLM_ENABLE_THINKING 后此值会被服务端忽略
CHAT_TEMPERATURE=0.7

# 思考模式（角色扮演建议保持 false，否则温度失效且更慢更贵）
LLM_ENABLE_THINKING=false
# low / high / max
LLM_THINKING_EFFORT=low

# ─── 计费（仅用于 @Kei LLM 的花费估算，元/百万 tokens）──
# 默认值对应 deepseek-flash 高峰价（汇率按 7.1 折算）
# LLM_PRICE_PROMPT=2.13          # 输入（缓存未命中）
# LLM_PRICE_CACHE_HIT=0.043      # 输入（缓存命中）
# LLM_PRICE_COMPLETION=8.52      # 输出
# LLM_PRICE_OFFPEAK_RATIO=0.5    # 低谷价 = 高峰价 × 此倍率

# ─── 其他 ─────────────────────────────────────────────
# 允许从台词池/语音文本自动提炼说话风格（默认关闭，人设以 persona.py 为准）
# PERSONA_AUTOLEARN=false
